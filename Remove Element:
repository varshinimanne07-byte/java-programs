import java.util.Arrays;

public class Main {
    public static void main(String[] args) {
        Solution solution = new Solution();
        int[] nums1 = {3, 2, 2, 3};
        int val1 = 3;
        System.out.println("Original: " + Arrays.toString(nums1) + ", Target to remove: " + val1);
        int k1 = solution.removeElement(nums1, val1);
        System.out.println("New length: " + k1);
        System.out.print("Modified array (first " + k1 + " elements): [");
        for (int i = 0; i < k1; i++) {
            System.out.print(nums1[i] + (i < k1 - 1 ? ", " : ""));
        }
        System.out.println("]\n");
        int[] nums2 = {0, 1, 2, 2, 3, 0, 4, 2};
        int val2 = 2;
        System.out.println("Original: " + Arrays.toString(nums2) + ", Target to remove: " + val2);
        int k2 = solution.removeElement(nums2, val2);
        System.out.println("New length: " + k2);
        System.out.print("Modified array (first " + k2 + " elements): [");
        for (int i = 0; i < k2; i++) {
            System.out.print(nums2[i] + (i < k2 - 1 ? ", " : ""));
        }
        System.out.println("]");
    }
}

class Solution {
    public int removeElement(int[] nums, int val) {
        int index = 0
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != val) {
                nums[index] = nums[i];
                index++;
            }
        }
        return index;
    }
}
